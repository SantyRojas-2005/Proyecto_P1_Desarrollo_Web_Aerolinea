@model IEnumerable<Progra_03.Models.Pasajero>

@{
    ViewBag.Title = "Gestión de Pasajeros";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 pt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h3 class="fw-bold mb-0" style="color: var(--altevia-blue);"><i class="bi bi-people me-2"></i>Gestión de Pasajeros</h3>
        <a href="@Url.Action("Create")" class="btn btn-altevia fw-bold px-4 shadow-sm">
            <i class="bi bi-plus-lg me-2"></i>Registrar Pasajero
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th>Documento</th>
                        <th>Nombres y Apellidos</th>
                        <th>Correo</th>
                        <th>Teléfono</th>
                        <th>Registro</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.TipoDocumentoCodigo<br /><span class="text-primary">@item.NumeroDocumento</span></td>
                            <td>@item.Apellidos, @item.Nombres</td>
                            <td>@(string.IsNullOrEmpty(item.Correo) ? "-" : item.Correo)</td>
                            <td>@(string.IsNullOrEmpty(item.Telefono) ? "-" : item.Telefono)</td>
                            <td>@item.FechaRegistro.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <div class="btn-group shadow-sm" role="group">
                                    <a href="@Url.Action("Edit", new { id=item.PasajeroId })" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                                    <a href="@Url.Action("Details", new { id=item.PasajeroId })" class="btn btn-sm btn-outline-secondary" title="Detalles"><i class="bi bi-eye"></i></a>
                                    <a href="@Url.Action("Delete", new { id=item.PasajeroId })" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>