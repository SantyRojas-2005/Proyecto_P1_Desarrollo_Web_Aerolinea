@{
    ViewBag.Title = "Solicitud enviada";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 pt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card card-reserva border-0 shadow-sm p-5">
                <i class="bi bi-envelope-check-fill mb-3" style="font-size: 4rem; color: var(--altevia-gold);"></i>
                <h3 class="fw-bold mb-3" style="color: var(--altevia-blue);">Solicitud procesada</h3>
                <p class="text-muted mb-4">
                    Si los datos corresponden a una cuenta registrada en nuestro sistema, recibirá las instrucciones en su correo electrónico para recuperar el acceso.
                </p>
                <div>
                    <a href="@Url.Action("Login", "Account")" class="btn btn-altevia px-5 py-2 fw-bold shadow-sm">Volver a Iniciar Sesión</a>
                </div>
            </div>
        </div>
    </div>
</div>