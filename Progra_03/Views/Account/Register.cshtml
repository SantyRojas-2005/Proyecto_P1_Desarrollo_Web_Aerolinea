@model Progra_03.Models.RegisterViewModel
@{
    ViewBag.Title = "Crear cuenta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 pt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card card-reserva border-0 shadow-sm">
                <div class="card-header bg-dark-blue text-white py-3 border-0">
                    <h5 class="mb-0 fw-bold" style="color: var(--altevia-gold);">Crear cuenta</h5>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">

                    @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "needs-validation", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger fw-bold mb-3" })

                        <div class="row g-3">
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Nombres, new { @class = "form-label fw-bold small text-muted text-uppercase" }) <span class="text-danger">*</span>
                                @Html.TextBoxFor(m => m.Nombres, new { @class = "form-control", placeholder = "Ej.: María José" })
                                @Html.ValidationMessageFor(m => m.Nombres, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.Apellidos, new { @class = "form-label fw-bold small text-muted text-uppercase" }) <span class="text-danger">*</span>
                                @Html.TextBoxFor(m => m.Apellidos, new { @class = "form-control", placeholder = "Ej.: Pérez Torres" })
                                @Html.ValidationMessageFor(m => m.Apellidos, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-12 mt-3">
                                @Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold small text-muted text-uppercase" }) <span class="text-danger">*</span>
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "correo@ejemplo.com" })
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6 mt-3">
                                @Html.LabelFor(m => m.Password, new { @class = "form-label fw-bold small text-muted text-uppercase" }) <span class="text-danger">*</span>
                                @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                                <div class="form-text small">Mín. 8 caracteres: mayúscula, minúscula, número y símbolo.</div>
                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6 mt-3">
                                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label fw-bold small text-muted text-uppercase" }) <span class="text-danger">*</span>
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-12 mt-3">
                                @Html.LabelFor(m => m.RolSeleccionado, new { @class = "form-label fw-bold small text-muted text-uppercase" }) <span class="text-danger">*</span>
                                <select name="RolSeleccionado" class="form-select border-primary">
                                    <option value="Cliente" selected>Cliente</option>
                                    @if (Request.IsAuthenticated && User.IsInRole("SuperUsuario"))
                                    {
                                        <option value="Administrador">Administrador</option>
                                        <option value="Counter">Counter</option>
                                        <option value="SuperUsuario">SuperUsuario</option>
                                    }
                                </select>
                                <div class="form-text small">Visitante: solo Cliente. Otros roles: solo SuperUsuario.</div>
                            </div>
                        </div>

                        <div class="card bg-light border-0 mt-4 p-3">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.AceptaCondiciones, new { @class = "form-check-input" })
                                <label class="form-check-label small fw-bold" for="AceptaCondiciones">
                                    Acepto el aviso de privacidad y las condiciones *
                                </label>
                            </div>
                            @Html.ValidationMessageFor(m => m.AceptaCondiciones, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mt-4 pt-3 border-top d-flex gap-3">
                            <button type="submit" class="btn btn-altevia px-5 shadow-sm">Crear cuenta</button>
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary px-4">Cancelar</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>