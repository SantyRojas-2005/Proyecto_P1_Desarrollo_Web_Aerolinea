@model Progra_03.Models.RegisterViewModel
@{
    ViewBag.Title = "Crear cuenta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container section-padding">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card card-reserva p-4">
                <div class="card-header bg-transparent border-0 text-center pb-0">
                    <h4 class="mb-4" style="color: var(--altevia-blue); letter-spacing: 2px;">ÚNETE A ALTÉVIA</h4>
                </div>

                <div class="card-body px-5 pb-5">
                    @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-4 fw-bold small" })

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label">Nombre de usuario <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", placeholder = "4-50 caracteres" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Correo electrónico <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "correo@ejemplo.com", type = "email" })
                            </div>
                        </div>

                        <div class="row g-4 mt-1">
                            <div class="col-md-6">
                                <label class="form-label">Contraseña <span class="text-danger">*</span></label>
                                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "********" })
                                <div class="form-text small mt-2" style="font-size: 0.7rem;">Mín. 8 caracteres, mayúscula, minúscula, número, símbolo.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Confirmar contraseña <span class="text-danger">*</span></label>
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "********" })
                            </div>
                        </div>

                        <div class="mt-5 mb-4">
                            <div class="p-3 mb-3" style="background-color: var(--altevia-ivory); border-left: 3px solid var(--altevia-gold); font-size: 0.75rem;">
                                <strong>Aviso de privacidad:</strong> Al registrarse, usted acepta las políticas de uso de Altévia para la simulación académica.
                            </div>
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input shadow-none" id="terminos" required>
                                <label class="form-check-label small" for="terminos">Acepto el aviso de privacidad y las condiciones <span class="text-danger">*</span></label>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-altevia">Crear cuenta</button>
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-gold pt-3">Cancelar</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}