@model Progra_03.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Recuperar acceso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 pt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card card-reserva border-0 shadow-sm">
                <div class="card-header bg-dark-blue text-white py-3 border-0">
                    <h5 class="mb-0 fw-bold" style="color: var(--altevia-gold);">Recuperar acceso</h5>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">
                    <p class="text-muted mb-4">Ingrese el correo o nombre de usuario asociado a su cuenta.</p>

                    @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { @class = "needs-validation", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger fw-bold mb-3" })

                        <div class="mb-4">
                            @Html.LabelFor(m => m.Email, "Correo electrónico *", new { @class = "form-label fw-bold small text-muted text-uppercase" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "correo@ejemplo.com", required = "required" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>

                        <div class="d-flex flex-wrap gap-3 align-items-center mb-4">
                            <button type="submit" class="btn btn-altevia px-4 shadow-sm">Solicitar recuperación</button>
                            <a href="@Url.Action("Login", "Account")" class="text-decoration-none text-muted small fw-bold">Volver al inicio de sesión</a>
                        </div>

                        <div class="alert alert-info border-0 shadow-sm mb-0 d-flex align-items-center" style="background-color: rgba(212, 175, 55, 0.1); color: var(--altevia-blue);">
                            <i class="bi bi-info-circle-fill fs-3 me-3" style="color: var(--altevia-gold);"></i>
                            <p class="mb-0 small fw-bold"><strong>Información:</strong> Si los datos corresponden a una cuenta registrada, recibirá las instrucciones para recuperar el acceso.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>