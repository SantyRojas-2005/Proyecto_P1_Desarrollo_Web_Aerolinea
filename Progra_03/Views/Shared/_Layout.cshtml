<!DOCTYPE html>
<html lang="es">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - ALTÉVIA</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>

        body {

            padding-top: @(ViewBag.Title == "Inicio" ? "0" : "90px");
        }


        .navbar-altevia {
            background-color: var(--altevia-blue) !important;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            padding: 10px 0;
            transition: all 0.4s ease;
        }


        .navbar-altevia.navbar-transparent {
            background-color: transparent !important;
            box-shadow: none;
            padding: 20px 0;
        }


        .navbar-altevia.navbar-scrolled {
            background-color: var(--altevia-blue) !important;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            padding: 10px 0;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-altevia fixed-top @(ViewBag.Title == "Inicio" ? "navbar-transparent" : "")">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center py-0" href="@Url.Action("Index", "Home")">
                <img src="~/Img/logo/logo.svg" alt="Altévia Logo" style="height: 75px; width: auto; object-fit: contain;" class="me-2" />
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list fs-2 text-white"></i>
            </button>

            <div class="collapse navbar-collapse justify-content-end">
                <ul class="navbar-nav align-items-center">
                    <li class="nav-item">@Html.ActionLink("Flota", "Index", "Home", new { area = "" }, new { @class = "nav-link text-white" })</li>
                    <li class="nav-item">@Html.ActionLink("Servicios", "Index", "Home", new { area = "" }, new { @class = "nav-link text-white" })</li>
                    <li class="nav-item">@Html.ActionLink("Destinos", "Index", "Home", new { area = "" }, new { @class = "nav-link text-white" })</li>
                    <li class="nav-item me-4">@Html.ActionLink("Contacto", "Index", "Home", new { area = "" }, new { @class = "nav-link text-white" })</li>

                    @if (Request.IsAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="color: var(--altevia-gold) !important;">
                                <i class="bi bi-person-circle"></i> @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="navbarDropdown">
                                <li>@Html.ActionLink("Mis Reservas", "MisReservas", "Reservas", new { area = "" }, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Check-in", "Index", "CheckIn", new { area = "" }, new { @class = "dropdown-item" })</li>
                                @if (User.IsInRole("Administrador") || User.IsInRole("SuperUsuario"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li>@Html.ActionLink("Administración", "Index", "Admin", new { area = "" }, new { @class = "dropdown-item fw-bold text-primary" })</li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "m-0 p-0" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <a href="javascript:document.getElementById('logoutForm').submit()" class="dropdown-item text-danger w-100 text-start">Cerrar sesión</a>
                                    }
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Iniciar sesión", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink", @class = "nav-link text-white" })
                        </li>
                        <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                            <a href="@Url.Action("Register", "Account")" id="registerLink" class="btn btn-outline-gold">Registrarse</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    @RenderBody()

    <footer class="bg-dark-blue pt-5 pb-4 mt-5">
        <div class="container text-center">
            <h4 style="font-family: 'Montserrat', sans-serif; letter-spacing: 4px; color: var(--altevia-gold); font-weight: 300;" class="mb-4">ALTÉVIA</h4>
            <div class="d-flex justify-content-center gap-4 mb-4" style="font-size: 0.8rem; letter-spacing: 1px;">
                <a href="#" class="text-white text-decoration-none">Legales</a>
                <a href="#" class="text-white text-decoration-none">Privacidad</a>
                <a href="#" class="text-white text-decoration-none">Contacto</a>
            </div>
            <p style="color: var(--altevia-steel); font-size: 0.8rem;" class="mb-0">
                &copy; @DateTime.Now.Year - BEYOND THE HORIZON &middot; Simulación Académica
            </p>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
                $(document).ready(function () {
                    if ($('.navbar-altevia').hasClass('navbar-transparent')) {
                        $(window).scroll(function () {
                            if ($(window).scrollTop() > 50) {
                                $('.navbar-altevia').removeClass('navbar-transparent').addClass('navbar-scrolled');
                            } else {
                                $('.navbar-altevia').removeClass('navbar-scrolled').addClass('navbar-transparent');
                            }
                        });
                    }
                });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
