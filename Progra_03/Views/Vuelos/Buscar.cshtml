@model IEnumerable<Progra_03.Models.vw_DisponibilidadVuelo>
@{
    ViewBag.Title = "Resultados de vuelos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool esEscala = ViewBag.EsEscala != null ? (bool)ViewBag.EsEscala : false;
}

<div class="container mt-5 pt-5 mb-5">
    <h2 style="color: var(--altevia-blue);">Resultados de vuelos</h2>

    <!-- Resumen de búsqueda -->
    <div class="d-flex flex-wrap align-items-center mb-4 text-muted border-bottom pb-2">
        <span class="me-3 fw-bold text-dark">
            <i class="bi bi-geo-alt-fill" style="color: var(--altevia-gold);"></i>
            @ViewBag.Origen &rarr; @ViewBag.Destino
        </span>
        <span class="me-3"><i class="bi bi-calendar-event"></i> Fecha: @ViewBag.Fecha</span>
        <span class="me-3"><i class="bi bi-person"></i> @ViewBag.Pasajeros pasajeros</span>
        @Html.ActionLink("Modificar búsqueda", "Index", "Home", null, new { @class = "ms-auto text-decoration-none", style = "color: var(--altevia-blue); font-weight: 600;" })
    </div>

    @if ((Model != null && Model.Any()) || esEscala)
    {
        <!-- VUELOS DIRECTOS -->
        foreach (var vuelo in Model)
        {
            // Validaciones de tiempo y negocio para habilitar reserva
            DateTime fechaHoraSalida = vuelo.FechaOperacion.Add(vuelo.HoraSalida);
            bool yaPaso = fechaHoraSalida <= DateTime.Now;

            bool hayCupo = vuelo.Disponibles >= ViewBag.Pasajeros;
            bool tieneAeronave = !string.IsNullOrEmpty(vuelo.Matricula);
            bool esValido = hayCupo && tieneAeronave && !yaPaso && vuelo.EstadoVueloCodigo != "CANCELADO" && vuelo.EstadoVueloCodigo != "COMPLETADO";

            <div class="card card-altevia mb-4 shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-5 mb-3 mb-md-0">
                            <h4 class="fw-bold mb-1" style="color: var(--altevia-blue);">@vuelo.HoraSalida.ToString(@"hh\:mm") - @vuelo.HoraLlegada.ToString(@"hh\:mm")</h4>
                            <p class="text-muted mb-1">
                                <strong>@vuelo.CodigoVuelo</strong> &middot; Vuelo Directo &middot;
                                Aeronave: @(tieneAeronave ? vuelo.Matricula : "Sin asignar")
                            </p>
                            @if (tieneAeronave)
                            {
                                <span class="badge bg-light text-dark border"><i class="bi bi-person-check-fill text-success"></i> @vuelo.Disponibles de @vuelo.Capacidad disponibles</span>
                            }
                        </div>

                        <div class="col-md-3 text-md-center mb-3 mb-md-0">
                            <span class="badge bg-light text-dark border p-2 mb-2">Estado: @vuelo.EstadoVueloCodigo</span>
                        </div>

                        <div class="col-md-4 text-md-end">
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                @Html.ActionLink("Consultar disponibilidad", "Disponibilidad", "Vuelos", new { id = vuelo.VueloId }, new { @class = "btn btn-outline-altevia w-100 mb-2 mb-md-0" })

                                @if (esValido)
                                {
                                    if (Request.IsAuthenticated)
                                    {
                                        @Html.ActionLink("Seleccionar vuelo", "SeleccionAsiento", "Reservas", new { vueloId = vuelo.VueloId, pasajeros = ViewBag.Pasajeros }, new { @class = "btn btn-altevia w-100" })
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("SeleccionAsiento", "Reservas", new { vueloId = vuelo.VueloId, pasajeros = ViewBag.Pasajeros }) })" class="btn btn-altevia w-100">Seleccionar vuelo</a>
                                    }
                                }
                                else
                                {
                                    <button class="btn btn-secondary w-100 disabled" disabled>
                                        @(yaPaso ? "Vuelo cerrado" : (tieneAeronave ? "Sin asientos disponibles" : "Vuelo no habilitado"))
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- VARIANTE: ITINERARIO CON ESCALA (GALÁPAGOS) -->
        if (esEscala)
        {
            var tramo1 = (Progra_03.Models.vw_DisponibilidadVuelo)ViewBag.Tramo1;
            var tramo2 = (Progra_03.Models.vw_DisponibilidadVuelo)ViewBag.Tramo2;

            DateTime fechaHoraSalidaEscala = tramo1.FechaOperacion.Add(tramo1.HoraSalida);
            bool yaPasoEscala = fechaHoraSalidaEscala <= DateTime.Now;

            bool hayCupoEscala = tramo1.Disponibles >= ViewBag.Pasajeros && tramo2.Disponibles >= ViewBag.Pasajeros;
            bool tienenAeronave = !string.IsNullOrEmpty(tramo1.Matricula) && !string.IsNullOrEmpty(tramo2.Matricula);
            bool esValidaEscala = hayCupoEscala && tienenAeronave && !yaPasoEscala && tramo1.EstadoVueloCodigo != "CANCELADO";

            <div class="card card-altevia mb-4 shadow-sm border-2 border-primary">
                <div class="card-header bg-light py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-signpost-split-fill text-primary me-2"></i>Variante: Itinerario con escala en Guayaquil</h6>
                </div>
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-8 mb-3 mb-md-0">
                            <p class="mb-2 text-muted small"><strong>Tramo 1:</strong> @tramo1.HoraSalida.ToString(@"hh\:mm") - @tramo1.HoraLlegada.ToString(@"hh\:mm") Quito &rarr; Guayaquil (@tramo1.CodigoVuelo)</p>
                            <p class="mb-3 text-muted small"><strong>Tramo 2:</strong> @tramo2.HoraSalida.ToString(@"hh\:mm") - @tramo2.HoraLlegada.ToString(@"hh\:mm") Guayaquil &rarr; Galápagos (@tramo2.CodigoVuelo)</p>

                            <span class="badge bg-light text-dark border">Tramo 1: @tramo1.Disponibles disp.</span>
                            <span class="badge bg-light text-dark border ms-2">Tramo 2: @tramo2.Disponibles disp.</span>
                        </div>

                        <div class="col-md-4 text-md-end">
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <!-- Botón que despliega los detalles -->
                                <button class="btn btn-outline-altevia w-100 mb-2 mb-md-0" type="button" data-bs-toggle="collapse" data-bs-target="#detallesEscala">
                                    Ver detalles
                                </button>

                                @if (esValidaEscala)
                                {
                                    if (Request.IsAuthenticated)
                                    {
                                        @Html.ActionLink("Seleccionar", "SeleccionAsiento", "Reservas", new { vueloId = tramo1.VueloId, pasajeros = ViewBag.Pasajeros }, new { @class = "btn btn-altevia w-100" })
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("SeleccionAsiento", "Reservas", new { vueloId = tramo1.VueloId, pasajeros = ViewBag.Pasajeros }) })" class="btn btn-altevia w-100">Seleccionar</a>
                                    }
                                }
                                else
                                {
                                    <button class="btn btn-secondary w-100 disabled" disabled>
                                        @(yaPasoEscala ? "Vuelo cerrado" : "Sin asientos")
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Panel colapsable con los detalles de los tramos (Misma zona de visibilidad de las variables) -->
                    <div class="collapse mt-3" id="detallesEscala">
                        <div class="card card-body bg-light border-0 small">
                            <strong class="text-primary mb-2">Itinerario detallado:</strong>
                            <p class="mb-1"><strong>Tramo 1 (VIP@(tramo1.VueloId.ToString("D5"))):</strong> Sale de @tramo1.Origen a las @tramo1.HoraSalida.ToString(@"hh\:mm") y llega a @tramo1.Destino a las @tramo1.HoraLlegada.ToString(@"hh\:mm"). Aeronave: @(string.IsNullOrEmpty(tramo1.Matricula) ? "Pendiente" : tramo1.Matricula).</p>
                            <p class="mb-0"><strong>Tramo 2 (VIP@(tramo2.VueloId.ToString("D5"))):</strong> Sale de @tramo2.Origen a las @tramo2.HoraSalida.ToString(@"hh\:mm") y llega a @tramo2.Destino a las @tramo2.HoraLlegada.ToString(@"hh\:mm"). Aeronave: @(string.IsNullOrEmpty(tramo2.Matricula) ? "Pendiente" : tramo2.Matricula).</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info p-4 text-center mt-4" style="background-color: #f8f9fa; border-color: var(--altevia-blue); color: var(--altevia-blue);">
            <h5 class="fw-bold mb-3">No hay vuelos disponibles para los criterios seleccionados.</h5>
            <p class="mb-0">Intente modificando la fecha o seleccionando un origen y destino diferente que opere en el día elegido.</p>
        </div>
    }
</div>