@model IEnumerable<Progra_03.Models.Comprobante>
@{
    ViewBag.Title = "Mis Comprobantes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 pt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold mb-0" style="color: var(--altevia-blue);">Mis Comprobantes</h2>
            <p class="text-muted mb-0">Historial de facturas académicas y notas de crédito</p>
        </div>
        <i class="bi bi-receipt fs-1" style="color: var(--altevia-gold);"></i>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card card-altevia border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle text-center mb-0">
                        <thead class="bg-light text-muted small text-uppercase">
                            <tr>
                                <th class="py-3 ps-4 text-start">N° Comprobante</th>
                                <th class="py-3">Fecha de Emisión</th>
                                <th class="py-3">Tipo</th>
                                <th class="py-3">Total (USD)</th>
                                <th class="py-3">Estado</th>
                                <th class="py-3 pe-4 text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-start fw-bold" style="color: var(--altevia-blue);">
                                        @item.NumeroComprobante
                                        <br />
                                        <span class="text-muted small fw-normal">Reserva #@item.Compra.ReservaId.ToString("D6")</span>
                                    </td>
                                    <td>@item.FechaEmision.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (item.TipoComprobanteCodigo == "FACTURA")
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary">Factura Académica</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">Nota de Crédito</span>
                                        }
                                    </td>
                                    <td class="fw-bold text-success">$@item.Compra.Importe</td>
                                    <td>
                                        @if (item.EstadoComprobanteCodigo == "EMITIDO")
                                        {
                                            <span class="badge bg-success">@item.EstadoComprobanteCodigo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.EstadoComprobanteCodigo</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        <!-- Enlace directo al método PDF que ya existe en ReservasController -->
                                        <a href="@Url.Action("DescargarPDF", "Reservas", new { id = item.Compra.ReservaId })" class="btn btn-outline-altevia btn-sm" target="_blank" title="Descargar Comprobante PDF">
                                            <i class="bi bi-file-earmark-pdf-fill me-1"></i> Descargar PDF
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info p-5 text-center shadow-sm border-0" style="background-color: #f8f9fa;">
            <i class="bi bi-inbox-fill mb-3" style="font-size: 3rem; color: var(--altevia-gold);"></i>
            <h4 class="fw-bold" style="color: var(--altevia-blue);">Sin comprobantes</h4>
            <p class="text-muted mb-0">Usted no ha realizado ninguna compra o cancelación que genere comprobantes hasta el momento.</p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-altevia mt-4 px-4">Buscar vuelos</a>
        </div>
    }
</div>