@model IEnumerable<Progra_03.Models.vw_ComprobanteDetalle>
@{
    ViewBag.Title = "Mis Comprobantes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 pt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h3 class="fw-bold mb-0" style="color: var(--altevia-blue);"><i class="bi bi-receipt-cutoff me-2"></i>Mis Comprobantes y Facturas</h3>
    </div>

    <!-- Filtros de Búsqueda -->
    <div class="card bg-light border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <form method="get" action="@Url.Action("Index")" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted text-uppercase">Desde (opcional)</label>
                    <input type="date" name="desde" class="form-control" value="@ViewBag.Desde" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted text-uppercase">Hasta (opcional)</label>
                    <input type="date" name="hasta" class="form-control" value="@ViewBag.Hasta" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted text-uppercase">Tipo (opcional)</label>
                    <select name="tipo" class="form-select">
                        <option value="Todos">Todos</option>
                        @foreach (var t in ViewBag.TiposComprobante as List<Progra_03.Models.TipoComprobante>)
                        {
                            <option value="@t.Codigo" @(ViewBag.Tipo == t.Codigo ? "selected" : "")>@t.Descripcion</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-grid gap-2">
                    <button type="submit" class="btn btn-altevia fw-bold shadow-sm">Filtrar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla Historial -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th>Número</th>
                        <th>Tipo</th>
                        <th>Fecha</th>
                        <th>Reserva</th>
                        <th>Importe</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.NumeroComprobante</td>
                                <td><span class="text-truncate d-inline-block" style="max-width: 250px;">@item.TipoComprobante</span></td>
                                <td>@item.FechaEmision.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge bg-light text-dark border">@item.CodigoReserva</span></td>
                                <td class="fw-bold text-dark">$@item.TotalOperacion.ToString("0.00")</td>
                                <td>
                                    @if (item.EstadoComprobanteCodigo == "EMITIDO")
                                    {<span class="badge bg-success">Emitido</span> }
                                    else
                                    { <span class="badge bg-danger">@item.EstadoComprobanteCodigo</span>}
                                </td>
                                <td class="text-end">
                                    <a href="@Url.Action("Index", new { idPreview = item.ComprobanteId, desde = ViewBag.Desde, hasta = ViewBag.Hasta, tipo = ViewBag.Tipo })" class="btn btn-sm btn-outline-secondary me-1">Visualizar</a>
                                    <!-- Reutilizamos tu generador PDF de Rotativa apuntándolo a la reserva -->
                                    <a href="@Url.Action("DescargarPDF", "Reservas", new { id = item.ReservaId })" class="btn btn-sm btn-danger shadow-sm"><i class="bi bi-file-pdf-fill"></i> Descargar PDF</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted">No hay comprobantes para los filtros seleccionados.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- PANEL DE VISTA PREVIA (Aparece al dar clic en Visualizar) -->
    @if (ViewBag.Preview != null)
    {
        var p = (Progra_03.Models.vw_ComprobanteDetalle)ViewBag.Preview;
        var pasajeros = (List<string>)ViewBag.PreviewPasajeros;
        var vuelos = (List<Progra_03.Models.vw_VueloDetalle>)ViewBag.PreviewVuelos;
        var asientos = (List<string>)ViewBag.PreviewAsientos;
        var detalles = (List<Progra_03.Models.ReservaPasajeroVuelo>)ViewBag.PreviewDetalles;

        <div class="card card-reserva border-0 shadow-lg mt-5" id="vista-previa">
            <div class="card-header bg-dark-blue text-white py-3 border-0 d-flex justify-content-between">
                <h5 class="mb-0 fw-bold" style="color: var(--altevia-gold);">Vista Previa</h5>
                <span class="badge bg-light text-dark fs-6">@p.NumeroComprobante</span>
            </div>
            <div class="card-body p-4 p-md-5">

                <div class="row mb-4 border-bottom pb-4">
                    <div class="col-md-6">
                        <p class="text-muted small text-uppercase mb-1 fw-bold">Emisor</p>
                        <h5 class="fw-bold text-dark">@p.EmisorNombre</h5>
                        <p class="mb-0 text-muted">ID: @p.EmisorIdentificacion</p>
                    </div>
                    <div class="col-md-6 text-md-end mt-3 mt-md-0">
                        <p class="text-muted small text-uppercase mb-1 fw-bold">Cliente / Reserva</p>
                        <h5 class="fw-bold text-dark">ID: @p.UsuarioId.Substring(0, Math.Min(8, p.UsuarioId.Length))...</h5>
                        <p class="mb-0 text-muted">Reserva Asoc: @p.CodigoReserva</p>
                        <p class="mb-0 text-muted">Trx: @p.MarcaTarjeta @p.TarjetaEnmascarada (@p.CodigoOperacion)</p>
                    </div>
                </div>

                <div class="table-responsive mb-4">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light small text-uppercase text-muted">
                            <tr>
                                <th>Pasajero</th>
                                <th>Vuelo</th>
                                <th>Ruta</th>
                                <th>Fecha</th>
                                <th class="text-center">Asiento</th>
                                <th class="text-end">Importe</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < detalles.Count; i++)
                            {
                                <tr>
                                    <td>@pasajeros[i]</td>
                                    <td class="fw-bold">@vuelos[i].CodigoVuelo</td>
                                    <td>@vuelos[i].CiudadOrigen &rarr; @vuelos[i].CiudadDestino</td>
                                    <td>@vuelos[i].FechaOperacion.ToString("dd/MM/yyyy")</td>
                                    <td class="fw-bold text-center" style="color: var(--altevia-blue);">@asientos[i]</td>
                                    <td class="text-end">$@detalles[i].ImporteTramo.ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="5" class="text-end fw-bold">TOTAL</td>
                                <td class="text-end fw-bold fs-5" style="color: var(--altevia-gold);">$@p.TotalOperacion.ToString("0.00") USD</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Advertencia Académica (DP-05) -->
                <div class="alert alert-info border-0 shadow-sm mb-0 d-flex align-items-center" style="background-color: rgba(212, 175, 55, 0.1); color: var(--altevia-blue);">
                    <i class="bi bi-info-circle-fill fs-3 me-3" style="color: var(--altevia-gold);"></i>
                    <p class="mb-0 small fw-bold"><strong>Información:</strong> @p.LeyendaComprobante</p>
                </div>
            </div>
        </div>

        <script>
            // Pequeño script para hacer autoscroll hacia la vista previa al cargar
            window.onload = function() {
                document.getElementById("vista-previa").scrollIntoView({ behavior: 'smooth' });
            };
        </script>
    }
</div>