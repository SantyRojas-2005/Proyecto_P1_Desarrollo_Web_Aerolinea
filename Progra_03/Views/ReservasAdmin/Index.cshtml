@model IEnumerable<Progra_03.Models.Reserva>

@{
    ViewBag.Title = "Reservas Globales";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 pt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h3 class="fw-bold mb-0" style="color: var(--altevia-blue);"><i class="bi bi-journal-bookmark-fill me-2"></i>Reservas Globales</h3>
        <a href="@Url.Action("Create")" class="btn btn-altevia fw-bold px-4 shadow-sm">
            <i class="bi bi-plus-lg me-2"></i>Nueva Reserva
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th>Código Reserva</th>
                        <th>ID Usuario</th>
                        <th>Fecha Creación</th>
                        <th>Fecha Expiración</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark fs-6">@Html.DisplayFor(modelItem => item.CodigoReserva)</td>
                            <td><span class="badge bg-light text-dark border">@item.UsuarioId.Substring(0, Math.Min(8, item.UsuarioId.Length))...</span></td>
                            <td>@item.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(item.FechaExpiracion.HasValue ? item.FechaExpiracion.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                            <td>
                                @if (item.EstadoReservaCodigo == "CONFIRMADA")
                                {<span class="badge bg-success">@item.EstadoReservaCodigo</span> }
                            else if (item.EstadoReservaCodigo == "PENDIENTE")
                            { <span class="badge bg-warning text-dark">@item.EstadoReservaCodigo</span> }
                        else
                        { <span class="badge bg-danger">@item.EstadoReservaCodigo</span>}
                            </td>
                            <td class="text-end">
                                <div class="btn-group shadow-sm" role="group">
                                    <a href="@Url.Action("Edit", new { id=item.ReservaId })" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                                    <a href="@Url.Action("Details", new { id=item.ReservaId })" class="btn btn-sm btn-outline-secondary" title="Detalles"><i class="bi bi-eye"></i></a>
                                    <a href="@Url.Action("Delete", new { id=item.ReservaId })" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>