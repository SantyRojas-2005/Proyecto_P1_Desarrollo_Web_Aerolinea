@model Progra_03.Models.Reserva
@{
    ViewBag.Title = "Eliminar Reserva";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 pt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="alert alert-danger shadow-sm border-0 mb-4 p-4 d-flex align-items-center">
                <i class="bi bi-exclamation-octagon-fill fs-2 me-4"></i>
                <div>
                    <h5 class="fw-bold mb-1">Confirmar Anulación de Registro</h5>
                    <p class="mb-0 small">¿Está seguro de que desea eliminar la reserva <strong>@Model.CodigoReserva</strong>? Los datos asociados podrían perderse. Esta acción no se puede deshacer.</p>
                </div>
            </div>

            <div class="card card-reserva border-0 shadow-sm">
                <div class="card-body p-4 bg-white">
                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item px-0 d-flex justify-content-between">
                            <span class="text-muted fw-bold small text-uppercase">Código</span>
                            <span class="fw-bold fs-5">@Model.CodigoReserva</span>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between">
                            <span class="text-muted fw-bold small text-uppercase">Estado Actual</span>
                            <span class="fw-bold">@Model.EstadoReservaCodigo</span>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between">
                            <span class="text-muted fw-bold small text-uppercase">Creada el</span>
                            <span>@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</span>
                        </li>
                    </ul>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        <div class="d-flex gap-3 mt-4">
                            <button type="submit" class="btn btn-danger px-5 fw-bold shadow-sm"><i class="bi bi-trash me-2"></i>Eliminar Registro</button>
                            <a href="@Url.Action("Gestion", "Admin", new { tab = "reservas" })" class="btn btn-outline-secondary px-4">Cancelar</a>
                        </div>
                    }
                </div>
            </div>

            <div class="mt-3 text-center text-muted small">
                <i class="bi bi-info-circle me-1"></i> Nota: Es preferible cambiar el estado a "CANCELADA" en lugar de eliminarla de la base de datos por motivos de auditoría.
            </div>

        </div>
    </div>
</div>