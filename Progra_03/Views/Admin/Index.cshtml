@{
    ViewBag.Title = "Panel de Administración";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .admin-card-menu {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .admin-card-menu:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    .admin-icon-box {
        width: 65px;
        height: 65px;
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
    }
</style>

<div class="container mt-5 pt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold mb-0" style="color: var(--altevia-blue);">Centro de Operaciones</h2>
            <p class="text-muted mb-0">Bienvenido, @User.Identity.Name | Nivel de acceso restringido</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- MOD-09: Módulo Counter (Visible para todos los roles autorizados) -->
        <div class="col-md-12 mb-2">
            <div class="card border-0 shadow-sm admin-card-menu position-relative bg-light">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="rounded-circle me-4 d-flex align-items-center justify-content-center admin-icon-box bg-white border-primary">
                        <i class="bi bi-headset fs-3 text-primary"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h5 class="fw-bold mb-1 text-primary">Asistencia de Counter</h5>
                        <p class="text-muted small mb-0 text-uppercase" style="letter-spacing: 1px;">Gestión de boletos y pasajeros (MOD-09)</p>
                    </div>
                    <div class="ms-3"><i class="bi bi-chevron-right fs-4 text-primary"></i></div>
                    <a href="@Url.Action("Asistencia", "Admin")" class="stretched-link"></a>
                </div>
            </div>
        </div>

        <!-- Solo Administradores y SuperUsuarios ven el resto -->
        @if (User.IsInRole("Administrador") || User.IsInRole("SuperUsuario"))
        {
            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm admin-card-menu position-relative">
                    <div class="card-body p-4 d-flex align-items-center">
                        <div class="rounded-circle me-4 d-flex align-items-center justify-content-center admin-icon-box">
                            <i class="bi bi-calendar-check fs-3" style="color: var(--altevia-blue);"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="fw-bold mb-1 text-dark">Vuelos e itinerarios</h5>
                            <p class="text-muted small mb-0 text-uppercase" style="letter-spacing: 1px;">Programación y horarios</p>
                        </div>
                        <div class="ms-3"><i class="bi bi-chevron-right fs-4" style="color: var(--altevia-gold);"></i></div>
                        <a href="@Url.Action("Vuelos", "Admin")" class="stretched-link"></a>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm admin-card-menu position-relative">
                    <div class="card-body p-4 d-flex align-items-center">
                        <div class="rounded-circle me-4 d-flex align-items-center justify-content-center admin-icon-box">
                            <i class="bi bi-airplane fs-3" style="color: var(--altevia-blue);"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="fw-bold mb-1 text-dark">Gestión de aeronaves</h5>
                            <p class="text-muted small mb-0 text-uppercase" style="letter-spacing: 1px;">Control de flota</p>
                        </div>
                        <div class="ms-3"><i class="bi bi-chevron-right fs-4" style="color: var(--altevia-gold);"></i></div>
                        <a href="@Url.Action("Aeronaves", "Admin")" class="stretched-link"></a>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm admin-card-menu position-relative">
                    <div class="card-body p-4 d-flex align-items-center">
                        <div class="rounded-circle me-4 d-flex align-items-center justify-content-center admin-icon-box">
                            <i class="bi bi-people fs-3" style="color: var(--altevia-blue);"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="fw-bold mb-1 text-dark">Usuarios, pasajeros y reservas</h5>
                            <p class="text-muted small mb-0 text-uppercase" style="letter-spacing: 1px;">Cuentas y boletos</p>
                        </div>
                        <div class="ms-3"><i class="bi bi-chevron-right fs-4" style="color: var(--altevia-gold);"></i></div>
                        <a href="@Url.Action("Gestion", "Admin")" class="stretched-link"></a>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm admin-card-menu position-relative">
                    <div class="card-body p-4 d-flex align-items-center">
                        <div class="rounded-circle me-4 d-flex align-items-center justify-content-center admin-icon-box">
                            <i class="bi bi-file-earmark-bar-graph fs-3" style="color: var(--altevia-blue);"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="fw-bold mb-1 text-dark">Consultas y reportes</h5>
                            <p class="text-muted small mb-0 text-uppercase" style="letter-spacing: 1px;">Estadísticas de ocupación</p>
                        </div>
                        <div class="ms-3"><i class="bi bi-chevron-right fs-4" style="color: var(--altevia-gold);"></i></div>
                        <a href="@Url.Action("Reportes", "Admin")" class="stretched-link"></a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>