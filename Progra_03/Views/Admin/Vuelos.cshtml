@model IEnumerable<Progra_03.Models.vw_VueloDetalle>
@{
    ViewBag.Title = "Vuelos e Itinerarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var aeronaves = ViewBag.Aeronaves as List<Progra_03.Models.Aeronave>;
    var estados = ViewBag.Estados as List<Progra_03.Models.EstadoVuelo>;
}

<div class="container mt-5 pt-4 mb-5">
    <h3 class="fw-bold mb-4" style="color: var(--altevia-blue);">Administración de Vuelos</h3>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success shadow-sm fw-bold"><i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]</div>
    }
    @if (TempData["ErrorValidacion"] != null)
    {
        <div class="alert alert-danger shadow-sm fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorValidacion"]</div>
    }

    <!-- Pestañas Administrativas Funcionales -->
    <ul class="nav nav-tabs mb-4" id="vuelosTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold text-white border-0" id="vuelos-tab" data-bs-toggle="tab" data-bs-target="#vuelos" type="button" role="tab" style="background-color: var(--altevia-blue);">Vuelos por fecha</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link text-muted border-0" id="frecuencias-tab" data-bs-toggle="tab" data-bs-target="#frecuencias" type="button" role="tab">Frecuencias aprobadas</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link text-muted border-0" id="itinerarios-tab" data-bs-toggle="tab" data-bs-target="#itinerarios" type="button" role="tab">Itinerarios y tramos</button>
        </li>
    </ul>

    <!-- Contenedor de las Pestañas -->
    <div class="tab-content" id="vuelosTabsContent">

        <!-- 1. PESTAÑA VUELOS POR FECHA -->
        <div class="tab-pane fade show active" id="vuelos" role="tabpanel">

            <!-- Barra de Filtros y Acciones -->
            <div class="card bg-light border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="row align-items-end g-3">

                        <!-- Filtro de Búsqueda (GET) -->
                        <div class="col-md-5 border-end pe-4">
                            <form method="get" action="@Url.Action("Vuelos")" class="row g-2">
                                <div class="col-5">
                                    <label class="form-label small fw-bold text-muted mb-1">Fecha desde</label>
                                    <input type="date" name="desde" class="form-control form-control-sm" value="@ViewBag.Desde" required />
                                </div>
                                <div class="col-5">
                                    <label class="form-label small fw-bold text-muted mb-1">Fecha hasta</label>
                                    <input type="date" name="hasta" class="form-control form-control-sm" value="@ViewBag.Hasta" required />
                                </div>
                                <div class="col-2 d-flex align-items-end">
                                    <button type="submit" class="btn btn-outline-dark btn-sm w-100"><i class="bi bi-search"></i></button>
                                </div>
                            </form>
                        </div>

                        <!-- Formulario de Generación de Vuelos (POST) -->
                        <div class="col-md-7 ps-4">
                            <form method="post" action="@Url.Action("GenerarVuelos")" class="row g-2 align-items-end" onsubmit="return confirm('¿Seguro que desea generar la programación para este rango de fechas?');">
                                @Html.AntiForgeryToken()
                                <div class="col-4">
                                    <label class="form-label small fw-bold text-primary mb-1">Generar Desde</label>
                                    <input type="date" name="fechaDesde" class="form-control form-control-sm border-primary" value="@ViewBag.Desde" required />
                                </div>
                                <div class="col-4">
                                    <label class="form-label small fw-bold text-primary mb-1">Generar Hasta</label>
                                    <input type="date" name="fechaHasta" class="form-control form-control-sm border-primary" value="@ViewBag.Hasta" required />
                                </div>
                                <div class="col-4">
                                    <button type="submit" class="btn btn-altevia btn-sm w-100 fw-bold"><i class="bi bi-gear-fill me-1"></i> Generar Vuelos</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tabla de Vuelos -->
            <div class="card shadow-sm border-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th>Código</th>
                                <th>Fecha</th>
                                <th>Ruta</th>
                                <th>Horario</th>
                                <th>Aeronave</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var vuelo in Model)
                                {
                                    <tr>
                                        <td class="fw-bold text-dark">@vuelo.CodigoVuelo</td>
                                        <td>@vuelo.FechaOperacion.ToString("dd/MM/yyyy")</td>
                                        <td>@vuelo.Origen &rarr; @vuelo.Destino</td>
                                        <td>@vuelo.HoraSalida.ToString(@"hh\:mm") - @vuelo.HoraLlegada.ToString(@"hh\:mm")</td>
                                        <td>
                                            @if (vuelo.AeronaveId != null)
                                            {
                                                <span class="badge bg-secondary">Asignada</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Sin asignar</span>
                                            }
                                        </td>
                                        <td>
                                            @if (vuelo.EstadoVueloCodigo == "CONFIRMADO")
                                            {<span class="badge bg-success border text-white">@vuelo.EstadoVueloCodigo</span> }
                                        else if (vuelo.EstadoVueloCodigo == "CANCELADO")
                                        { <span class="badge bg-danger border text-white">@vuelo.EstadoVueloCodigo</span> }
                                    else
                                    { <span class="badge bg-light border text-dark">@vuelo.EstadoVueloCodigo</span>}
                                        </td>
                                        <td class="text-end">
                                            <!-- Botón para abrir el Modal de Edición -->
                                            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalEditar-@vuelo.VueloId">Editar</button>
                                        </td>
                                    </tr>

                                    <!-- Modal de Edición Específico por Fila -->
                                    <div class="modal fade" id="modalEditar-@vuelo.VueloId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header bg-dark-blue text-white">
                                                    <h5 class="modal-title" style="color: var(--altevia-gold);">Editar Vuelo @vuelo.CodigoVuelo</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                @using (Html.BeginForm("EditarVueloRapido", "Admin", FormMethod.Post))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <div class="modal-body p-4">
                                                        <input type="hidden" name="VueloId" value="@vuelo.VueloId" />

                                                        <div class="mb-3">
                                                            <label class="form-label fw-bold small text-muted">Aeronave Asignada <span class="text-danger">*</span></label>
                                                            <select name="AeronaveId" class="form-select">
                                                                <option value="">-- Sin asignar --</option>
                                                                @foreach (var avion in aeronaves)
                                                                {
                                                                    <option value="@avion.AeronaveId" @(vuelo.AeronaveId == avion.AeronaveId ? "selected" : "")>
                                                                        @avion.Matricula (Cap: 7)
                                                                    </option>
                                                                }
                                                            </select>
                                                        </div>

                                                        <div class="mb-3">
                                                            <label class="form-label fw-bold small text-muted">Estado Operativo <span class="text-danger">*</span></label>
                                                            <select name="EstadoVueloCodigo" class="form-select" required>
                                                                @foreach (var estado in estados)
                                                                {
                                                                    <option value="@estado.Codigo" @(vuelo.EstadoVueloCodigo == estado.Codigo ? "selected" : "")>
                                                                        @estado.Descripcion
                                                                    </option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer bg-light">
                                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                        <button type="submit" class="btn btn-altevia px-4">Guardar Cambios</button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <tr><td colspan="7" class="text-center py-4 text-muted">No hay vuelos programados en este rango de fechas.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div> <!-- FIN PESTAÑA VUELOS -->
        <!-- 2. PESTAÑA FRECUENCIAS -->
        <div class="tab-pane fade bg-white p-4 shadow-sm border rounded" id="frecuencias" role="tabpanel">
            <h5 class="fw-bold mb-3 text-dark">Matriz de Frecuencias Operativas</h5>
            <table class="table table-hover align-middle">
                <thead class="table-light small text-uppercase text-muted">
                    <tr><th>Día de Operación</th><th>Salida</th><th>Llegada</th><th>Estado</th></tr>
                </thead>
                <tbody>
                    @foreach (var f in ViewBag.Frecuencias as List<Progra_03.Models.Frecuencia>)
                    {
                        <tr>
                            <td class="fw-bold text-primary">Día @f.DiaSemana (1=Lun, 7=Dom)</td>
                            <td>@f.HoraSalida</td>
                            <td>@f.HoraLlegada</td>
                            <td><span class="badge bg-success">Activa</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- 3. PESTAÑA ITINERARIOS -->
        <div class="tab-pane fade bg-white p-4 shadow-sm border rounded" id="itinerarios" role="tabpanel">
            <h5 class="fw-bold mb-3 text-dark">Itinerarios y Escalas</h5>
            <table class="table table-hover align-middle">
                <thead class="table-light small text-uppercase text-muted">
                    <tr><th>Referencia</th><th>Descripción</th><th>Estado Comercial</th></tr>
                </thead>
                <tbody>
                    @foreach (var i in ViewBag.Itinerarios as List<Progra_03.Models.Itinerario>)
                    {
                        <tr>
                            <td class="fw-bold">@i.Referencia</td>
                            <td>@i.Nombre</td>
                            <td><span class="badge bg-dark">@i.EstadoItinerarioCodigo</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div> <!-- FIN TAB CONTENT -->
</div> <!-- FIN CONTAINER -->

@section Scripts {
    <script>
                $('button[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
                    $('button[data-bs-toggle="tab"]').css('background-color', '').removeClass('text-white fw-bold').addClass('text-muted');
                    $(e.target).css('background-color', 'var(--altevia-blue)').removeClass('text-muted').addClass('text-white fw-bold');
                });
    </script>
}