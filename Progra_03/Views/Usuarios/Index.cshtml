@model List<Progra_03.Controllers.UsuarioListaViewModel>
@{
    ViewBag.Title = "Gestión de Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 pt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold mb-0" style="color: var(--altevia-blue);">Gestión de Usuarios</h3>
            <p class="text-muted mb-0 small">Cuentas, roles y estado de acceso (MOD-01 / MOD-10)</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Gestion", "Admin")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Volver</a>
            <a href="@Url.Action("Create")" class="btn btn-altevia"><i class="bi bi-person-plus me-1"></i> Crear usuario</a>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success"><i class="bi bi-check-circle me-1"></i> @TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i> @TempData["Error"]</div>
    }

    <form method="get" action="@Url.Action("Index")" class="row g-2 mb-3">
        <div class="col-md-5">
            <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por usuario, correo o rol..." />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-altevia"><i class="bi bi-search"></i> Buscar</button>
            @if (!string.IsNullOrEmpty(ViewBag.Buscar as string))
            {
                <a href="@Url.Action("Index")" class="btn btn-link">Limpiar</a>
            }
        </div>
    </form>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase text-muted">
                    <tr><th>Usuario</th><th>Correo</th><th>Rol</th><th>Estado</th><th class="text-end">Acciones</th></tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No se encontraron usuarios.</td></tr>
                    }
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-bold">
                                @u.UserName
                                @if (u.EsUsuarioActual)
                                {<span class="badge bg-light text-dark border ms-1">Usted</span>}
                            </td>
                            <td>@u.Email</td>
                            <td><span class="badge" style="background-color: var(--altevia-blue);">@u.Rol</span></td>
                            <td>
                                @if (u.Bloqueado)
                                {<span class="badge bg-danger">Inactivo</span>}
                                else
                                {<span class="badge bg-success">Activo</span>}
                            </td>
                            <td class="text-end text-nowrap">
                                @if (u.PuedeGestionar)
                                {
                                    <a href="@Url.Action("Edit", new { id = u.Id })" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Editar</a>
                                    if (!u.EsUsuarioActual)
                                    {
                                        using (Html.BeginForm("Delete", "Usuarios", FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('¿Eliminar al usuario " + u.UserName + "? Esta acción no se puede deshacer.');" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", u.Id)
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Eliminar</button>
                                        }
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small"><i class="bi bi-lock-fill"></i> Solo SuperUsuario</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
