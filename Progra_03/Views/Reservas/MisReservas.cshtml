@model IEnumerable<Progra_03.Models.Reserva>
@{
    ViewBag.Title = "Mis Reservas";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Recuperamos los diccionarios del controlador
    var vuelos = ViewBag.InfoVuelos as Dictionary<int, Progra_03.Models.vw_VueloDetalle>;
    var pasajeros = ViewBag.InfoPasajeros as Dictionary<int, Progra_03.Models.Pasajero>;
    var totales = ViewBag.InfoTotales as Dictionary<int, decimal>;
}

<div class="container mt-5 pt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="fw-bold" style="color: var(--altevia-blue);">Mis Reservas</h2>
        @Html.ActionLink("Buscar nuevo vuelo", "Index", "Home", null, new { @class = "btn btn-outline-gold" })
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var reserva in Model)
            {
                // Extraemos la información específica de esta reserva usando su ID
                var vuelo = vuelos != null && vuelos.ContainsKey(reserva.ReservaId) ? vuelos[reserva.ReservaId] : null;
                var pasajero = pasajeros != null && pasajeros.ContainsKey(reserva.ReservaId) ? pasajeros[reserva.ReservaId] : null;
                var total = totales != null && totales.ContainsKey(reserva.ReservaId) ? totales[reserva.ReservaId] : 0m;

                if (vuelo != null && pasajero != null)
                {
                    <div class="col-12 mb-4">
                        <div class="card card-reserva border-0 shadow-sm">
                            <div class="card-body p-0">
                                <div class="row g-0">
                                    <!-- Columna de Fecha y Estado -->
                                    <div class="col-md-3 p-4 border-end bg-light d-flex flex-column justify-content-center text-center">
                                        <span class="text-muted small text-uppercase fw-bold mb-1">Fecha de Viaje</span>
                                        <h4 class="fw-bold mb-3" style="color: var(--altevia-blue);">@vuelo.FechaOperacion.ToString("dd MMM yyyy")</h4>

                                        @if (reserva.EstadoReservaCodigo == "CONFIRMADA")
                                        {
                                            <span class="badge bg-success py-2 w-100"><i class="bi bi-check-circle me-1"></i> Confirmada</span>
                                        }
                                        else if (reserva.EstadoReservaCodigo == "PENDIENTE")
                                        {
                                            <span class="badge bg-warning text-dark py-2 w-100"><i class="bi bi-clock me-1"></i> Pendiente</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger py-2 w-100"><i class="bi bi-x-circle me-1"></i> @reserva.EstadoReservaCodigo</span>
                                        }
                                    </div>

                                    <!-- Columna de Detalles -->
                                    <div class="col-md-6 p-4 d-flex flex-column justify-content-center">
                                        <div class="d-flex align-items-center mb-2">
                                            <h5 class="fw-bold mb-0 me-3">@vuelo.CodigoVuelo (@vuelo.CiudadOrigen &rarr; @vuelo.CiudadDestino)</h5>
                                            <span class="text-muted small">Cód: @reserva.CodigoReserva</span>
                                        </div>
                                        <p class="mb-1 text-muted"><i class="bi bi-person-fill me-2"></i>Pasajero: <strong>@pasajero.Nombres @pasajero.Apellidos</strong></p>
                                        <p class="mb-0 text-muted small"><i class="bi bi-calendar-plus me-2"></i>Reservado el: @reserva.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</p>
                                    </div>

                                    <!-- Columna de Acción / Precio -->
                                    <div class="col-md-3 p-4 d-flex flex-column justify-content-center align-items-end border-start">
                                        <h4 class="fw-bold mb-3" style="color: var(--altevia-gold);">$@total USD</h4>

                                        @if (reserva.EstadoReservaCodigo == "CONFIRMADA")
                                        {
                                            <a href="@Url.Action("Boleto", "Reservas", new { id = reserva.ReservaId })" class="btn btn-altevia w-100 mb-2">Ver Boleto</a>
                                            <a href="@Url.Action("Gestionar", "Reservas", new { id = reserva.ReservaId })" class="btn btn-outline-secondary w-100 mb-2">Gestionar</a>
                                        }
                                        else if (reserva.EstadoReservaCodigo == "PENDIENTE")
                                        {
                                            <a href="@Url.Action("Pago", "Reservas", new { id = reserva.ReservaId })" class="btn btn-altevia w-100 mb-2">Pagar Ahora</a>
                                            <a href="@Url.Action("Gestionar", "Reservas", new { id = reserva.ReservaId })" class="btn btn-outline-secondary w-100 mb-2">Gestionar</a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("Gestionar", "Reservas", new { id = reserva.ReservaId })" class="btn btn-outline-secondary w-100 mb-2">Ver Detalle</a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <div class="alert alert-light border p-5 text-center shadow-sm">
            <i class="bi bi-ticket-detailed text-muted mb-3" style="font-size: 3rem;"></i>
            <h4 class="fw-bold" style="color: var(--altevia-blue);">Aún no tiene reservas</h4>
            <p class="text-muted mb-4">Explore nuestros destinos y disfrute de la experiencia Altévia.</p>
            @Html.ActionLink("Explorar Vuelos", "Index", "Home", null, new { @class = "btn btn-altevia px-4" })
        </div>
    }
</div>