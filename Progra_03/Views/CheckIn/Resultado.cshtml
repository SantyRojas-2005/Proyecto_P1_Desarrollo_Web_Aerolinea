@model Progra_03.Models.ReservaPasajeroVuelo
@{
    ViewBag.Title = "Confirmar Check-in";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var vuelo = (Progra_03.Models.vw_VueloDetalle)ViewBag.Vuelo;
    var pasajero = (Progra_03.Models.Pasajero)ViewBag.Pasajero;
    var asiento = (Progra_03.Models.Asiento)ViewBag.Asiento;
    var reserva = (Progra_03.Models.Reserva)ViewBag.Reserva;
}

<div class="container mt-5 pt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h3 class="fw-bold mb-4 text-center" style="color: var(--altevia-blue);">Verificación de Datos</h3>

            <!-- Boarding Pass Preview -->
            <div class="card card-reserva border-0 overflow-hidden mb-4 shadow-sm">
                <div class="row g-0">
                    <div class="col-md-8 p-5">
                        <p class="text-muted small text-uppercase letter-spacing-2 mb-1">Pasajero</p>
                        <h4 class="fw-bold mb-4" style="color: var(--altevia-blue);">@pasajero.Nombres @pasajero.Apellidos</h4>

                        <div class="row mb-4">
                            <div class="col-6">
                                <p class="text-muted small text-uppercase letter-spacing-2 mb-1">Vuelo</p>
                                <h5 class="fw-bold">@vuelo.CodigoVuelo</h5>
                            </div>
                            <div class="col-6">
                                <p class="text-muted small text-uppercase letter-spacing-2 mb-1">Fecha</p>
                                <h5 class="fw-bold">@vuelo.FechaOperacion.ToString("dd MMM yyyy")</h5>
                            </div>
                        </div>

                        <div class="row align-items-center mb-2">
                            <div class="col-5">
                                <h2 class="fw-bold mb-0" style="color: var(--altevia-blue);">@vuelo.CiudadOrigen</h2>
                                <p class="text-muted">@vuelo.HoraSalida.ToString(@"hh\:mm")</p>
                            </div>
                            <div class="col-2 text-center text-muted">
                                <i class="bi bi-airplane fs-4" style="color: var(--altevia-gold);"></i>
                            </div>
                            <div class="col-5 text-end">
                                <h2 class="fw-bold mb-0" style="color: var(--altevia-blue);">@vuelo.CiudadDestino</h2>
                                <p class="text-muted">@vuelo.HoraLlegada.ToString(@"hh\:mm")</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 p-5 text-center d-flex flex-column justify-content-center" style="background-color: var(--altevia-ivory); border-left: 2px dashed #d1d1d1;">
                        <p class="text-muted small text-uppercase letter-spacing-2 mb-1">Asiento</p>
                        <h1 class="display-4 fw-bold mb-4" style="color: var(--altevia-gold);">@asiento.Codigo</h1>
                        <p class="text-muted small text-uppercase letter-spacing-2 mb-1">Reserva</p>
                        <h5 class="fw-bold mb-0">@reserva.CodigoReserva</h5>
                    </div>
                </div>
            </div>

            <!-- Panel de Acción -->
            <div class="text-center p-4 bg-white rounded shadow-sm border-top border-3" style="border-color: var(--altevia-gold) !important;">
                @if (ViewBag.YaHizoCheckIn)
                {
                    <div class="alert alert-success d-inline-block px-4 py-3 fw-bold m-0">
                        <i class="bi bi-check-all fs-5 me-2"></i> Usted ya ha realizado el Check-in para este vuelo.
                    </div>
                }
                else
                {
                    <p class="text-muted mb-3">Revise que los datos sean correctos. Al confirmar, declarará no portar artículos prohibidos.</p>
                    using (Html.BeginForm("Confirmar", "CheckIn", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="AsignacionId" value="@Model.AsignacionId" />

                        <button type="submit" class="btn btn-altevia px-5 py-3 fw-bold fs-5 shadow-sm">
                            <i class="bi bi-shield-check me-2"></i> Confirmar Check-in
                        </button>
                    }
                }
            </div>

            <div class="text-center mt-3">
                <a href="@Url.Action("Index", "CheckIn")" class="text-muted text-decoration-none small"><i class="bi bi-arrow-left me-1"></i> Volver a búsqueda</a>
            </div>
        </div>
    </div>
</div>